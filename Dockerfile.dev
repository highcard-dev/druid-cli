FROM golang:bullseye AS builder

ARG VERSION=docker
COPY . /go
WORKDIR /go
RUN CGO_ENABLED=0 go build -ldflags "-X github.com/highcard-dev/daemon/internal.Version=${VERSION}" -o /out/druid-dev ./apps/druid-dev

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/druid-dev /usr/local/bin/druid-dev
ENTRYPOINT ["druid-dev"]
